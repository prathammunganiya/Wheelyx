# =====================================================================
# Wheelyx Backend - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to Git or public repositories.
# In Railway: Configure these under Service Settings -> Variables.
# =====================================================================

# Server Port (Railway automatically sets PORT; defaults to 8080)
PORT=8080
APP_ENV=production

# ---------------------------------------------------------------------
# Database Connection (Aiven MySQL)
# ---------------------------------------------------------------------
# Option 1: Individual Parameters (Recommended for Railway + Aiven)
DB_HOST=mysql-your-project-aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# Required SSL settings for Aiven MySQL
# Aiven strictly enforces SSL (--require_secure_transport=ON)
DB_SSL_MODE=REQUIRED
DB_USE_SSL=true

# Option 2: Full JDBC URL (Alternative)
# DB_URL=jdbc:mysql://mysql-your-project-aivencloud.com:12345/defaultdb?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# Connection Pool (HikariCP)
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30000

# ---------------------------------------------------------------------
# CORS Configuration (Allowed origins for your frontend)
# Set to your frontend domain (e.g. https://wheelyx.vercel.app) or *
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------
# Third-Party Integrations
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
UPLOAD_DIR=/tmp/uploads/vehicles
