classDiagram
    class User {
        +Long id
        +String name
        +String email
        +String phone
        +String passwordHash
        +String role
        +String status
    }

    class Vehicle {
        +Long id
        +Long ownerId
        +Integer categoryId
        +Integer cityId
        +Long placeId
        +String brand
        +String modelName
        +String registrationNo
        +BigDecimal pricePerDay
        +BigDecimal securityDeposit
        +String status
    }

    class Booking {
        +Long id
        +String bookingCode
        +Long customerId
        +Long vehicleId
        +LocalDate startDate
        +LocalDate endDate
        +Integer durationDays
        +BigDecimal totalAmount
        +String status
    }

    class Rental {
        +Long id
        +String rentalCode
        +Long bookingId
        +Timestamp handoverTime
        +Timestamp returnTime
        +int startOdometer
        +int endOdometer
        +String status
    }

    class Bill {
        +Long id
        +String billNo
        +Long bookingId
        +BigDecimal baseAmount
        +BigDecimal taxAmount
        +BigDecimal finalAmount
        +String status
    }

    class Review {
        +Long id
        +Long rentalId
        +Long customerId
        +Long vehicleId
        +int rating
        +String comment
    }

    User "1" --> "*" Booking : places
    Vehicle "1" --> "*" Booking : reserved for
    Booking "1" --> "1" Rental : initiates
    Booking "1" --> "1" Bill : generates
    Rental "1" --> "0..1" Review : verified by
